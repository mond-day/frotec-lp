# Servidor de e-mail que envia os leads do formulario para o time comercial.
# Todas sao lidas em runtime pela rota /api/lead, entao podem ser definidas como
# variaveis do servico na stack do Portainer Swarm sem rebuildar a imagem.

# Servidor de saida (SMTP) do e-mail institucional.
SMTP_HOST=
# 587 com STARTTLS (padrao) ou 465 com TLS direto.
SMTP_PORT=587
# Deixe vazio para o padrao: true na porta 465, false nas demais.
SMTP_SECURE=
# Credenciais da caixa institucional. Em provedores com 2FA (Google Workspace,
# Microsoft 365), SMTP_PASS e uma senha de aplicativo, nao a senha de login.
SMTP_USER=
SMTP_PASS=

# Quem recebe os leads. Aceita varios enderecos separados por virgula.
LEAD_EMAIL_TO=
# Opcional. Sem valor, o remetente e o proprio SMTP_USER — que e o que a maioria
# dos servidores exige para nao recusar ou marcar a mensagem como spam.
LEAD_EMAIL_FROM=

# Area logada /propostas (gerador de PDF). Login unico, sem tabela de usuarios.
# Tambem lidas em runtime. Ficam em texto no Portainer, no mesmo padrao do SMTP_PASS.
PROPOSTAS_USER=
PROPOSTAS_PASSWORD=
# Chave para assinar o cookie de sessao (HMAC). Use uma string longa e aleatoria.
PROPOSTAS_SESSION_SECRET=

# PDF do contrato: enquanto nao for exatamente true, o arquivo sai com marca d'agua
# "MINUTA — NÃO VALIDADA JURIDICAMENTE". Lida em runtime, sem rebuild.
CONTRATO_MINUTA_APROVADA=
